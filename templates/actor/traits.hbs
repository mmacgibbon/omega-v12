{{! Core Traits Section }}
<section class='traits-section'>
  <div class='traits-container'>
    {{! Physical Traits }}
    <div class='trait-group physical-traits'>
      <h3 class='trait-group-title'>{{localize 'OMEGA.CoreTraits.Physical'}}</h3>
      <div class='trait-grid'>
        {{#each system.coreTraits.physical as |trait key|}}
          <div class='trait-item' data-trait='{{key}}'>
            <label class='trait-label' for='system.coreTraits.physical.{{key}}.base'>
              {{localize trait.label}}
            </label>
            <div class='trait-content'>
              <div class='trait-base'>
                <label class='trait-sub-label'>Base</label>
                <input
                  type='number'
                  name='system.coreTraits.physical.{{key}}.base'
                  value='{{trait.base}}'
                  min='0'
                  max='10'
                  data-dtype='Number'
                  class='trait-base-value'
                />
              </div>
              <div class='trait-modifier-section'>
                <label class='trait-sub-label'>Mod</label>
                <input
                  type='number'
                  name='system.coreTraits.physical.{{key}}.modifier'
                  value='{{trait.modifier}}'
                  min='0'
                  data-dtype='Number'
                  class='trait-modifier-value'
                />
              </div>
              <div class='trait-total'>
                <span class='trait-total-label'>Total</span>
                <span class='trait-total-value'>{{trait.value}}</span>
              </div>
            </div>
          </div>
        {{/each}}
      </div>
    </div>

    {{! Mental Traits }}
    <div class='trait-group mental-traits'>
      <h3 class='trait-group-title'>{{localize 'OMEGA.CoreTraits.Mental'}}</h3>
      <div class='trait-grid'>
        {{#each system.coreTraits.mental as |trait key|}}
          <div class='trait-item' data-trait='{{key}}'>
            <label class='trait-label' for='system.coreTraits.mental.{{key}}.base'>
              {{localize trait.label}}
            </label>
            <div class='trait-content'>
              <div class='trait-base'>
                <label class='trait-sub-label'>Base</label>
                <input
                  type='number'
                  name='system.coreTraits.mental.{{key}}.base'
                  value='{{trait.base}}'
                  min='0'
                  max='10'
                  data-dtype='Number'
                  class='trait-base-value'
                />
              </div>
              <div class='trait-modifier-section'>
                <label class='trait-sub-label'>Mod</label>
                <input
                  type='number'
                  name='system.coreTraits.mental.{{key}}.modifier'
                  value='{{trait.modifier}}'
                  min='0'
                  data-dtype='Number'
                  class='trait-modifier-value'
                />
              </div>
              <div class='trait-total'>
                <span class='trait-total-label'>Total</span>
                <span class='trait-total-value'>{{trait.value}}</span>
              </div>
            </div>
          </div>
        {{/each}}
      </div>
    </div>
  </div>
</section> 